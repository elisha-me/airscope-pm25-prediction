@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#edf3fb;background:#0b1220}*{box-sizing:border-box}body{margin:0;display:flex;min-height:100vh;background:radial-gradient(ellipse at 76% -20%,#18343a55,transparent 42%),#0b1220}.sidebar{width:245px;flex-shrink:0;border-right:1px solid #202d40;padding:28px 17px 20px;display:flex;flex-direction:column;background:#0a111dee}.brand{display:flex;gap:11px;align-items:center;padding:0 10px 42px}.brandmark{height:39px;width:39px;border-radius:12px;background:linear-gradient(135deg,#54e2c0,#1c8f9d);color:#08211f;display:grid;place-items:center;font-size:26px}.brand b{font:800 17px Manrope;display:block}.brand small{font-size:8px;letter-spacing:1.1px;color:#7e91a9;display:block;margin-top:3px}.navlabel,.eyebrow{font-size:10px;letter-spacing:1.4px;font-weight:700;color:#7f91a9}.navlabel{padding:0 12px 12px}.nav{padding:12px;border-radius:9px;color:#8e9eb3;font-size:12px;margin-bottom:5px}.nav.active{background:#172c35;color:#65e0c0;border:1px solid #24494a}.nav.muted{opacity:.72}.nav small{float:right;font-size:8px;border:1px solid #334256;border-radius:4px;padding:3px 4px}.sidebottom{margin-top:auto}.modelchip{display:flex;align-items:center;gap:10px;background:#121f2d;border:1px solid #25384a;padding:13px 11px;border-radius:11px}.modelchip i,.connection i,.topstatus i{width:7px;height:7px;background:#4dd5af;border-radius:50%;display:inline-block;box-shadow:0 0 0 4px #4dd5af18}.modelchip b,.modelchip small{display:block}.modelchip b{font-size:11px}.modelchip small{font-size:10px;color:#8497ad;margin-top:4px}.sidebottom p{font-size:10px;color:#64768d;padding:5px 4px}main{min-width:0;flex:1;padding:0 34px 22px;max-width:1600px;margin:auto}header{height:70px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #202d40}.crumb{font-size:11px;color:#8c9bb0}.crumb span{padding:0 9px;color:#40516a}.topstatus{display:flex;align-items:center;gap:9px;font-size:9px;letter-spacing:1px;color:#9aa9bb}.avatar{margin-left:9px;width:29px;height:29px;border-radius:50%;background:#20394a;color:#7ee6cb;display:grid;place-items:center;font-size:10px;font-weight:700}.heading{display:flex;justify-content:space-between;align-items:flex-end;padding:32px 0 24px}.eyebrow{color:#53d6b3}.heading h1{font:800 29px Manrope;letter-spacing:-1.2px;margin:11px 0 7px}.heading h1 span{color:#8192a9;font-weight:500}.heading p{margin:0;color:#8e9db1;font-size:12px}.location{padding:10px 13px;border:1px solid #29394e;border-radius:9px;color:#dce6f3;font-size:11px;background:#101a29}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.metric,.panel,.bottom article{background:linear-gradient(145deg,#142031f2,#0f1928f2);border:1px solid #25344a;border-radius:13px}.metric{padding:17px 18px;min-height:121px}.metric>div{display:flex;align-items:center;justify-content:space-between;color:#94a4b8;font-size:11px}.metric>div b{color:#59d8b7;background:#1b3a3d;border-radius:8px;padding:7px}.metric strong{font:800 25px Manrope;letter-spacing:-.7px;display:block;margin:12px 0 3px}.metric strong small{font:500 11px 'DM Sans';color:#92a2b7}.metric p{font-size:10px;color:#71849c;margin:0}.content{display:grid;grid-template-columns:minmax(320px,.86fr) minmax(380px,1.14fr);gap:15px;margin-top:16px}.panel{padding:21px 22px;min-width:0}.panelhead{display:flex;align-items:center;justify-content:space-between;gap:10px}.panelhead h2{font:700 17px Manrope;letter-spacing:-.4px;margin:7px 0 0}.panelicon{width:35px;height:35px;display:grid;place-items:center;color:#5ce0bd;background:#1b3b3d;border-radius:10px}.desc{font-size:11px;line-height:1.6;color:#8496ac;margin:13px 0 19px}label{display:flex;justify-content:space-between;font-size:11px;color:#cbd5e3;margin-bottom:8px}label span{color:#72869e;font-size:10px}.inputwrap{height:43px;display:flex;align-items:center;gap:10px;border:1px solid #2c3d52;background:#0e1827;border-radius:8px;padding:0 12px;color:#6d829a;margin-bottom:16px}.inputwrap:focus-within{border-color:#4cc9ac;box-shadow:0 0 0 3px #4cc9ac13}.inputwrap input{min-width:0;width:100%;border:0;outline:0;background:transparent;color:#f1f6fc;font-size:13px}.inputwrap em{font-size:9px;color:#71849a;font-style:normal}.two{display:grid;grid-template-columns:1fr 1fr;gap:13px}.hint{display:flex;gap:7px;color:#71849a;font-size:9px;margin:1px 0 16px}button{font:inherit;cursor:pointer}.predictbtn,form button{display:block;width:100%;height:44px;border:0;border-radius:8px;background:linear-gradient(100deg,#48d7b3,#4abdc0);color:#07201f;font-size:12px;font-weight:700}.predictbtn:disabled{opacity:.7}.connection{display:flex;align-items:center;gap:8px;color:#71849a;font-size:9px;margin-top:15px}.connection i{width:6px;height:6px}.smallbtn{border:1px solid #2c3d52;border-radius:7px;background:#111d2d;color:#aebbd0;padding:8px 10px;font-size:10px}.chartmeta{display:flex;align-items:center;justify-content:space-between;margin-top:25px;font-size:10px;color:#92a1b5}.chartmeta span{display:flex;align-items:center;gap:7px}.chartmeta i{width:18px;height:3px;border-radius:3px;background:#44d6b3}.chartmeta b{font-size:8px;letter-spacing:.7px;border:1px solid #4a5a44;border-radius:4px;padding:4px 6px;color:#c4d79a}.chart{height:220px;margin-top:8px}.chart svg{width:100%;height:100%;overflow:visible}.gridlines path{stroke:#243247;stroke-dasharray:3 5;fill:none}.labels{fill:#8492a8;font-size:10px}.area{fill:url(#fill)}.line{fill:none;stroke:#44d6b3;stroke-width:2.5;vector-effect:non-scaling-stroke}.chartnote{font-size:9px;color:#7d91a8;padding:8px 0 14px;border-bottom:1px solid #263448}.chartstats{display:flex;gap:42px;padding-top:14px}.chartstats small,.chartstats b{display:block}.chartstats small{font-size:9px;color:#71849b;margin-bottom:5px}.chartstats b{font-size:10px;font-weight:600;color:#c8d4e4}.bottom{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:15px}.bottom article{display:flex;align-items:flex-start;gap:12px;padding:16px}.bottomicon{height:34px;width:34px;border-radius:9px;display:grid;place-items:center;flex-shrink:0;background:#1c3b3d;color:#5be0bd}.bottomicon.blue{background:#203449;color:#80c4f0}.bottom b{font-size:11px}.bottom p{font-size:10px;line-height:1.55;color:#8193aa;margin:6px 0 0}.bottom article>span{margin-left:auto;color:#71849b}footer{padding-top:22px;text-align:center;font-size:9px;color:#63768e}footer span{padding:0 6px;color:#4c5c70}.hidden{display:none!important}.error{margin-top:13px;padding:11px;border:1px solid #704447;background:#321f2a;border-radius:8px;color:#ffb8b8;font-size:11px;line-height:1.5}.result{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:14px;padding:15px;border:1px solid #285c55;background:#112d30;border-radius:9px}.result small{font-size:10px}.result strong{font:800 25px Manrope;display:block;margin-top:5px}.result .label{font-size:9px;letter-spacing:1px;color:#8eb8b2}.result .band{text-align:right;font-size:12px}.result .band small{display:block;color:#91a9b6;margin-top:5px}@media(max-width:1100px){.sidebar{width:210px}main{padding:0 22px 22px}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.content{grid-template-columns:1fr}}@media(max-width:700px){.sidebar{display:none}main{padding:0 15px 20px}.heading{align-items:flex-start;gap:15px;flex-direction:column;padding:25px 0 18px}.heading h1{font-size:25px}.metrics{gap:9px}.metric{padding:13px;min-height:112px}.metric strong{font-size:21px}.content{margin-top:12px}.panel{padding:17px 15px}.two{gap:9px}.bottom{grid-template-columns:1fr;gap:10px}.chart{height:220px}}@media(max-width:390px){.metric{padding:11px}.metric strong{font-size:19px}.two{grid-template-columns:1fr}.heading h1{font-size:22px}}
